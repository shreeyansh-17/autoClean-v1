# AutoClean — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Groq model to use (see Settings > AI Configuration for options)
GROQ_MODEL=openai/gpt-oss-20b

# LLM inference settings
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# Privacy: set to false to send only statistics (no cell values) to the LLM
SEND_SAMPLE_VALUES=true

# Max characters per prompt before splitting into batches
MAX_PROMPT_CHARS=20000

# Use rule-based fallback if Groq API is unavailable
FALLBACK_ON_LLM_FAILURE=true

